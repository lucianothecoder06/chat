rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Un documento de imagen no puede pasar de ~700 KB de Base64 (el límite de Firestore es 1 MiB)
    function imageOk(img) {
      return img == null || (img is string && img.size() < 700000);
    }

    // Cada usuario solo escribe su propio perfil; cualquiera con sesión puede verlo (lista de usuarios)
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && imageOk(request.resource.data.get('photoBase64', null));
      allow delete: if false;
    }

    // El id del chat es "uidA_uidB" (uids ordenados), así que se sabe quién participa sin leer el documento.
    // Eso permite escuchar un chat que todavía no existe (primer mensaje, indicador de "escribiendo")
    function inChat(chatId) {
      return request.auth.uid in chatId.split('_');
    }

    match /chats/{chatId} {
      allow read: if signedIn() && inChat(chatId);
      allow create: if signedIn() && inChat(chatId)
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      // Se actualiza el resumen del último mensaje y el campo typing; los participantes no cambian
      allow update: if signedIn() && inChat(chatId)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && inChat(chatId);
        allow create: if signedIn() && inChat(chatId)
          && request.resource.data.senderId == request.auth.uid
          && imageOk(request.resource.data.get('imageBase64', null));
        // Los mensajes no se editan ni se borran
        allow update, delete: if false;
      }
    }
  }
}
